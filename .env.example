APP_ENV=local

# ---------------------------------------------------------------------------
# 数据库 / 缓存
# ---------------------------------------------------------------------------
# App connects via asyncpg
DATABASE_URL=postgresql+asyncpg://mealforge:mealforge@localhost:5432/mealforge
REDIS_URL=redis://localhost:6379/0

# Consumed by docker-compose to provision Postgres(仅本地, 线上托管库不需要)
POSTGRES_USER=mealforge
POSTGRES_PASSWORD=mealforge
POSTGRES_DB=mealforge

# ---------------------------------------------------------------------------
# Clerk (auth)
# ---------------------------------------------------------------------------
# 你 Clerk 实例的 Frontend API URL（也是 JWT 的 `iss`）。
# dev 示例：https://literate-koala-34.clerk.accounts.dev
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# 逗号分隔的允许 azp origin（如 http://localhost:5173）。留空则跳过 azp 校验（仅 dev）。
# 部署后必须填线上前端域名, 且与浏览器地址栏完全一致(协议/无尾斜杠/裸域 vs www 均敏感)。
CLERK_AUTHORIZED_PARTIES_RAW=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# 逗号分隔。localhost 与 127.0.0.1 是不同 origin, 两个都要写。
# 部署后追加线上前端域名 —— 与 CLERK_AUTHORIZED_PARTIES_RAW 必须同步修改。
CORS_ALLOWED_ORIGINS_RAW=http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------------------
# Inventory
# ---------------------------------------------------------------------------
# 距过期几天内算"临期"(黄色提醒)
INVENTORY_EXPIRY_WARNING_DAYS=3

# ---------------------------------------------------------------------------
# AI (Google Gemini)
# ---------------------------------------------------------------------------
# Google AI Studio 免费层 key。留空时 mock 测试仍可跑, 但真实生成会失败。
# ⚠️ 线上只通过 `fly secrets set` 注入, 绝不写进镜像或提交进仓库。
# ⚠️ 在 AI Studio 重新生成 key 时不要点 "Set up billing", 否则该项目失去免费层。
GEMINI_API_KEY=
# 模型串号可配置: 模型会下线(gemini-2.5-flash 曾对新用户返回 404),
# 换模型只改这一行, 不动代码。
GEMINI_MODEL=gemini-3.1-flash-lite
# 单次生成输出上限(一个菜谱够用)
AI_MAX_TOKENS=2048